# Claude and AI-generated artifacts
.claude/
.superpowers/
# Audit scratchpad (per-agent findings, synthesis catalogs, fix-logs).
# Contents are useful as reference during active work but not part of the
# project history — never commit.
audit/
# Ignore docs/* (AI-generated scratchpads) but re-include curated dirs.
# Git won't descend into an excluded directory, so the exclusion targets the
# *contents* of docs/ rather than the dir itself.
docs/*
!docs/benchmarks/
CLAUDE.md
AGENTS.md
.cursor/
.aider*
plan.md
plans/
.specstory/

# macOS
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db

# Xcode
DerivedData/
build/
dist/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/
*.xcworkspace/xcuserdata/
*.xcuserstate
*.hmap
*.moved-aside

# Swift Package Manager (Package.resolved in xcshareddata stays committed)
.build/
.swiftpm/xcode/package.xcworkspace/xcuserdata/

# Rust / Cargo
target/

# Editors
.idea/
.vscode/
*.swp
*.swo
*~

# Credentials and signing
*.p12
*.p12.base64
*.cer
*.certSigningRequest
*.mobileprovision
AuthKey_*.p8
Credentials.xcconfig
.env
.env.*
!.env.example
dsa_priv.pem
eddsa_priv.pem
# Developer-ID export password stash (name convention — never commit).
PWORD*
DevID*
# Local signing workspace. Everything is ignored; only the README is tracked
# so the convention is discoverable.
.signing/*
!.signing/README.md

# cbindgen metadata artifact (written to repo root during header generation)
libnull.rmeta

# Logs and misc
*.log
